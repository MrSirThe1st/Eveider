{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "20.18.0",
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_AUTH_API_URL": "https://www.eveider.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://clgcdbgnqqiosnijdbns.supabase.co"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "node": "20.18.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_AUTH_API_URL": "https://www.eveider.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://clgcdbgnqqiosnijdbns.supabase.co"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "node": "20.18.0",
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_AUTH_API_URL": "https://www.eveider.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://clgcdbgnqqiosnijdbns.supabase.co"
      }
    }
  },
  "submit": {
    "production": {}
  }
