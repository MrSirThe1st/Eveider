{
  "expo": {
    "name": "Eveider",
    "slug": "eveider",
    "owner": "marcim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "eveider",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/012d7761-6d77-47e2-ab1d-d1da2bfe3a2e",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Eveider utilise la caméra pour scanner les colis et photographier le dépôt au casier.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eveider utilise votre position pour afficher les points de retrait proches.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/eveider_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1C1A17",
          "defaultChannel": "eveider_operations",
          "sounds": []
        }
      ]
    ],
    "splash": {
      "image": "./src/assets/eveider_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eveider.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Eveider utilise la caméra pour scanner les colis et photographier le dépôt au casier.",
        "NSLocationWhenInUseUsageDescription": "Eveider utilise votre position pour afficher les points de retrait proches.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1A17"
      },
      "package": "com.eveider.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "eveider",
              "host": "invite",
              "pathPrefix": "/"
            },
            {
              "scheme": "eveider",
              "host": "reset-password"
            },
            {
              "scheme": "eveider",
              "host": "auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "012d7761-6d77-47e2-ab1d-d1da2bfe3a2e"
      }
    }
  }
}
