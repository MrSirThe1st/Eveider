{
  "expo": {
    "name": "Eveider",
    "slug": "eveider",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "eveider",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Eveider utilise la caméra pour scanner les colis et photographier le dépôt au casier."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eveider utilise votre position pour afficher les points de retrait proches."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/eveider_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-localization"
    ],
    "splash": {
      "image": "./src/assets/eveider_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eveider.app",
      "associatedDomains": []
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F6F7"
      },
      "package": "com.eveider.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "eveider",
              "host": "invite",
              "pathPrefix": "/"
            },
            {
              "scheme": "eveider",
              "host": "reset-password"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
