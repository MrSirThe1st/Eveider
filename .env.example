# Supabase project: clgcdbgnqqiosnijdbns
# Dashboard: https://supabase.com/dashboard/project/clgcdbgnqqiosnijdbns

# Web portal (Next.js) — publishable key (client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://clgcdbgnqqiosnijdbns.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Unified Eveider web manager (admin + business + mobile APIs)
# Dev: http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Mobile (Expo) — same values
EXPO_PUBLIC_SUPABASE_URL=https://clgcdbgnqqiosnijdbns.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (never expose to client, never commit real values)
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (recommended for the running app — avoids free-tier session limits):
# `pgbouncer=true` is appended automatically for port 6543 if omitted.
DATABASE_URL=postgresql://postgres.clgcdbgnqqiosnijdbns:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# Direct connection (optional — SQL migrations if pooler rejects DDL):
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.clgcdbgnqqiosnijdbns.supabase.co:5432/postgres
# Optional: force session pooler instead of transaction pooler (local only)
# PG_USE_SESSION_POOLER=1

# Mobile auth API
# Local Expo web / iOS simulator: http://127.0.0.1:3000 (avoid localhost — IPv6 ::1 is not served)
# Android emulator: http://10.0.2.2:3000 (or leave localhost; the app rewrites it)
# Physical device: http://<MAC-LAN-IP>:3000 or https://www.eveider.com
EXPO_PUBLIC_AUTH_API_URL=https://www.eveider.com

# Invite links (web landing + deep link base URL)
# Production invites must use the public portal (not localhost).
INVITE_WEB_BASE_URL=https://www.eveider.com
INVITE_DEEP_LINK_SCHEME=eveider
# Local-only invite testing: INVITE_WEB_BASE_URL=http://localhost:3000
# Expo web (rare): INVITE_WEB_BASE_URL=http://localhost:19006
# Optional: signing secret for guest track sessions (defaults to SUPABASE_SERVICE_ROLE_KEY)
# TRACK_TOKEN_SECRET=
# Create a key at https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Legacy Mapbox (removed — keep blank or delete)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# WhatsApp Cloud API (Meta) — parcel status templates
# Use the TEST phone number ID until the business is verified.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_PARCEL_IN_TRANSIT_TEMPLATE=eveider_parcel_in_transit
WHATSAPP_PARCEL_ARRIVED_TEMPLATE=eveider_parcel_arrived
WHATSAPP_PARCEL_INVITE_TEMPLATE=eveider_parcel_invite
# Invite template: {{1}} business name, {{2}} web invite link
# Arrived template sends an app link (no PIN) — Utility category
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Resend — organization team invites (admin, dispatcher)
# Create a key at https://resend.com/api-keys
# From address must use a domain verified in Resend (currently updates.eveider.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Eveider <ops@updates.eveider.com>"

# PawaPay sandbox
PAWAPAY_API_TOKEN=
PAWAPAY_API_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_ENV=sandbox
PAWAPAY_DEFAULT_COUNTRY=COD
PAWAPAY_PICKUP_FEE_AMOUNT=5
PAWAPAY_PICKUP_FEE_CURRENCY=USD
